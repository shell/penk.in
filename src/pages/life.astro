---
import Base from '../layouts/Base.astro';
import { requireCollection } from '../lib/content';
import { decadeOf, formatPartialDate } from '../lib/dates';
import { groupBy, newestFirst } from '../lib/group';

const entries = await requireCollection('life');
const decades = groupBy(newestFirst(entries, (e) => e.data.date), (e) => decadeOf(e.data.date));
---
<Base title="Life" description="Milestones from Vladimir Penkin's life, by decade." og="life" path="/life">
  <h1>Life</h1>
  {decades.map(({ key, items }) => (
    <section class="timeline">
      <h2>{key}</h2>
      <ol>
        {items.map(({ data }) => (
          <li>
            <span class="meta">{formatPartialDate(data.date)}</span>
            <div>
              <strong>{data.url ? <a href={data.url}>{data.title}</a> : data.title}</strong>
              {data.description && <p>{data.description}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
