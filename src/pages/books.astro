---
import BookCover from '../components/BookCover.astro';
import Base from '../layouts/Base.astro';
import { requireCollection } from '../lib/content';
import { yearOf } from '../lib/dates';
import { groupBy, newestFirst } from '../lib/group';

const books = await requireCollection('books');
const years = groupBy(newestFirst(books, (b) => b.data.read), (b) => String(yearOf(b.data.read)));
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
---
<Base title="Books" description="Books Vladimir Penkin has read, by year." og="books" path="/books">
  <h1>Books</h1>
  {years.map(({ key, items }) => (
    <section class="book-year">
      <h2>{key}</h2>
      <ul class="shelf">
        {items.map(({ data }) => (
          <li>
            <BookCover title={data.title} author={data.author} isbn={data.isbn} />
            <p class="book-title">{data.url ? <a href={data.url}>{data.title}</a> : data.title}</p>
            <p class="meta">{data.author}</p>
            {data.rating && <p class="meta" aria-label={`${data.rating} out of 5`}>{stars(data.rating)}</p>}
            {data.note && <p class="muted book-note">{data.note}</p>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
