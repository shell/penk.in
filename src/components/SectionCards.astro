---
import type { Hue } from '../lib/hues';
import type { IconName } from '../lib/icons';
import Icon from './Icon.astro';

const CARDS: { href: string; title: string; teaser: string; icon: IconName; hue: Hue }[] = [
  { href: '/about', title: 'About', teaser: 'Generalist, city explorer, tea drinker', icon: 'user', hue: 'blue' },
  { href: '/resume', title: 'Résumé', teaser: 'The work side, one page + PDF', icon: 'file-text', hue: 'accent' },
  { href: '/life', title: 'Life', teaser: 'From Lunokhod (1995) to now', icon: 'clock', hue: 'green' },
  { href: '/books', title: 'Books', teaser: "What I've been reading", icon: 'book-open', hue: 'purple' },
  { href: '/links', title: 'Links', teaser: 'Personal sites I like', icon: 'link', hue: 'blue' },
  { href: '/contact', title: 'Contact', teaser: 'work@penk.in — say hi', icon: 'mail', hue: 'green' },
];
---
<ul class="section-cards">
  {CARDS.map(({ href, title, teaser, icon, hue }) => (
    <li>
      <a class="section-card" href={href}>
        <span class={`tile hue-${hue}`}><Icon name={icon} /></span>
        <span>
          <strong>{title}</strong>
          <span class="teaser">{teaser}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
