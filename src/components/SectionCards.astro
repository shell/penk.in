---
import type { Hue } from '../lib/hues';
import type { IconName } from '../lib/icons';
import Icon from './Icon.astro';
import ObfuscatedEmail from './ObfuscatedEmail.astro';

// teaser `null` = the obfuscated email followed by " — say hi".
const CARDS: { href: string; title: string; teaser: string | null; icon: IconName; hue: Hue }[] = [
  { href: '/about', title: 'About', teaser: 'Generalist, city explorer, tea drinker', icon: 'solar-user', hue: 'blue' },
  { href: '/resume', title: 'Résumé', teaser: 'The work side, one page + PDF', icon: 'solar-resume', hue: 'accent' },
  { href: '/testimonials', title: 'Testimonials', teaser: "Kind words from people I've worked with", icon: 'solar-testimonials', hue: 'accent' },
  { href: '/life', title: 'Life', teaser: 'From Lunokhod (1995) to now', icon: 'solar-life', hue: 'green' },
  { href: '/books', title: 'Books', teaser: "What I've been reading", icon: 'solar-books', hue: 'purple' },
  { href: '/links', title: 'Links', teaser: 'Sites and people I like', icon: 'solar-links', hue: 'blue' },
  { href: '/contact', title: 'Contact', teaser: null, icon: 'solar-contact', hue: 'green' },
];
---
<ul class="section-cards">
  {CARDS.map(({ href, title, teaser, icon, hue }, i) => (
    <li class={`hue-${hue}`}>
      <a class="section-card" href={href}>
        <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="body">
          <strong>{title}</strong>
          <span class="teaser">{teaser ?? <><ObfuscatedEmail /> — say hi</>}</span>
        </span>
        <Icon name={icon} class="glyph" />
      </a>
    </li>
  ))}
</ul>
