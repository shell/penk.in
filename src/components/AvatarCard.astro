---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';

interface Props {
  size?: number;
  class?: string;
}
const { size = 160, class: className } = Astro.props;
---
<Image
  src={avatar}
  alt="Illustrated portrait of Vladimir Penkin"
  width={size}
  height={size}
  densities={[1, 2]}
  format="webp"
  loading="eager"
  class:list={['avatar-card', className]}
/>
