---
import { Image } from 'astro:assets';
import { coverFor } from '../lib/covers';

interface Props {
  title: string;
  author: string;
  isbn?: string;
}
const { title, author, isbn } = Astro.props;
const cover = coverFor(isbn);
---
{cover ? (
  <Image src={cover} alt={`Cover of ${title} by ${author}`} width={180} densities={[1, 2]} format="webp" loading="lazy" class="cover" />
) : (
  <div class="cover cover-fallback" aria-hidden="true">
    <span class="cover-title">{title}</span>
    <span class="cover-author">{author}</span>
  </div>
)}
